# Copy this file to `.env` and fill in your own credentials.
# `.env` is gitignored and must never be committed.
#
# These are only needed to run the realtime engine (realtime_chat.py /
# fast_brain.py). The orchestration core needs no keys at all.

# --- Fast brain (LLM) ---
# doubao ARK key (https://www.volcengine.com/product/doubao)
ARK_API_KEY_FAST=
# Alibaba DashScope key (optional fallback model)
DASHSCOPE_API_KEY=

# --- 端到端实时语音（新版 duplex 协议，推荐）---
# 控制台「STEP1 获取 API Key」拿到的那一个 Key 就是它；
# 新版协议只需要这一个值（不需要 App ID / Resource-Id / App-Key）。
# 申请与验证步骤见 docs/CREDENTIALS.md
VOLC_DUPLEX_API_KEY=

# --- 旧版端到端语音（doubao SC2.0 二进制协议，realtime_chat.py）---
# 仅当使用 --arch realtime 时才需要；控制台新协议下通常拿不到这两个值。
VOLC_DIALOG_APP_ID=
VOLC_DIALOG_ACCESS_KEY=

# --- Optional: realtime built-in web search ---
VOLC_WEBSEARCH_API_KEY=
VOLC_WEBSEARCH_BOT_ID=

# --- Optional cloned voices used by the public voice_registry adapter ---
# Keep real voice ids in your local .env only.
CHARACTER_A_VOICE_ID=
CHARACTER_A_VOICE_MODEL=cosyvoice-v3-plus
CHARACTER_B_VOICE_ID=
CHARACTER_B_VOICE_MODEL=cosyvoice-v3-plus
