# 复制为 .env 并填写(已被 .gitignore 忽略,绝不提交)

# ---- 美客多开发者应用(Mexico)----
# 在 https://developers.mercadolibre.com.mx 创建应用后获取
MLM_CLIENT_ID=
MLM_CLIENT_SECRET=
# 回调地址,需与应用里配置的 Redirect URI 一致
MLM_REDIRECT_URI=http://localhost:8080/callback

# ---- 站点(默认墨西哥)----
MLM_SITE_ID=MLM

# ---- 蓝鲸选品(等 API 文档填充)----
BLUEWHALE_API_BASE=
BLUEWHALE_API_KEY=

# ---- 可选:请求最小间隔(秒),默认 0.15,不要低于 0.1 ----
MLM_REQUEST_INTERVAL=0.15
